# Copia este fichero a `.env` y rellena los valores reales — nunca los commitees.
# En producción (Render), estas variables se configuran como secretos de la plataforma.

# Supabase (ver design.md, decisiones 3b/3c)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Proveedor de IA (ver design.md, decisión 4)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Cifrado en reposo de los mensajes de chat (ver src/chat/message-encryption.ts) -- 32 bytes en
# base64 (AES-256). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# En producción (Render), NO reutilices la misma clave que en local -- cada entorno, la suya.
CHAT_ENCRYPTION_KEY=

# Nivel de log de Pino (opcional, por defecto "info")
LOG_LEVEL=

# Orígenes permitidos para CORS (opcional), lista separada por comas — p. ej. la URL de Vercel en
# producción (tarea 19.4). Sin definir, cae a http://localhost:4200 (puerto de `ng serve` en local).
CORS_ORIGIN=
